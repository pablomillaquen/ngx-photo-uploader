{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "photo-uploader": {
      "projectType": "library",
      "root": "projects/photo-uploader",
      "sourceRoot": "projects/photo-uploader/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/photo-uploader/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/photo-uploader/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/photo-uploader/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/photo-uploader/tsconfig.spec.json",
            "karmaConfig": "projects/photo-uploader/karma.conf.js",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "f0f2a95c-b06e-4409-8b5a-d3e9c5b90a6e"
  }
}
